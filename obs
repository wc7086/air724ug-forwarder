-- OBS 智能分段录制脚本
local obs = obslua
local timer = nil

-- 日志记录函数
function log(message)
    local ts = os.date("%H:%M:%S")
    obs.script_log(obs.LOG_INFO, "["..ts.."][智能录制] "..message)
end

-- 安全移除定时器
function remove_timer()
    if timer then
        obs.timer_remove(timer)
        timer = nil
        log("定时器已移除")
    end
end

-- 计算下一小时的时间戳
function next_hour_delay()
    local now = os.time()
    local next_h = now - (now % 3600) + 3600
    return (next_h - now) * 1000  -- 返回毫秒
end

-- 创建日期目录
function create_date_dir(base_path)
    -- 标准化路径格式
    base_path = base_path:gsub("\\", "/"):gsub("/+$", "")
    
    -- 生成年月路径
    local t = os.date("*t")
    local date_path = string.format("%s/%d/%02d/", base_path, t.year, t.month)
    
    -- 执行创建命令
    local cmd
    if package.config:sub(1,1) == "\\" then  -- Windows
        cmd = string.format('mkdir "%s" 2>nul', date_path)
    else  -- macOS/Linux
        cmd = string.format('mkdir -p "%s" 2>/dev/null', date_path)
    end
    
    if os.execute(cmd) then
        log("目录已创建: "..date_path)
        return date_path
    else
        log("目录创建失败，使用默认路径")
        return base_path
    end
end

-- 更新录制路径
function update_recording_path()
    local service = obs.obs_frontend_get_record_output()
    if not service then return end
    
    local settings = obs.obs_output_get_settings(service)
    local current_path = obs.obs_data_get_string(settings, "path") or ""
    
    -- 获取基础路径
    local base_dir = current_path:match("^(.*/)[^/]*$") or ""
    if base_dir == "" then
        base_dir = obs.obs_frontend_get_current_record_output_path()
        base_dir = base_dir:match("^(.*/)[^/]*$") or ""
    end
    
    -- 创建新路径
    local new_path = create_date_dir(base_dir)
    
    -- 更新设置
    obs.obs_data_set_string(settings, "path", new_path)
    obs.obs_output_update(service, settings)
    
    -- 释放资源
    obs.obs_data_release(settings)
    obs.obs_output_release(service)
    
    log("录制路径更新为: "..new_path)
end

-- 重启录制流程
function restart_recording()
    -- 停止录制
    if obs.obs_frontend_recording_active() then
        log("正在停止当前录制...")
        obs.obs_frontend_recording_stop()
    end
    
    -- 1秒后启动新录制
    obs.timer_add(function()
        -- 更新路径
        local ok, err = pcall(update_recording_path)
        if not ok then
            log("路径更新错误: "..tostring(err))
        end
        
        -- 开始录制
        if not obs.obs_frontend_recording_active() then
            obs.obs_frontend_recording_start()
            log("新录制已启动")
        end
        
        -- 重置定时器
        remove_timer()
        timer = obs.timer_add(restart_recording, next_hour_delay())
        log("下一周期定时器已设置")
    end, 1000)
end

-- 脚本生命周期
function script_load()
    log("脚本已加载")
    timer = obs.timer_add(restart_recording, next_hour_delay())
end

function script_unload()
    log("脚本卸载中...")
    remove_timer()
    log("脚本已卸载")
end

